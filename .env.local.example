# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com → your project → Settings → API

# Backend selection: "supabase" (default) or "local-postgres" for local testing
ORQE_DATA_BACKEND=supabase

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only — bypasses RLS. NEVER expose to client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Local Postgres (used when ORQE_DATA_BACKEND=local-postgres) ──────────────
# Option A: single URL
# LOCAL_DATABASE_URL=postgresql://username@localhost:5432/scholararena_test
#
# Option B: split vars (fallback if LOCAL_DATABASE_URL not set)
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=scholararena_test
# PGUSER=your-mac-username

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Phase 1B: qualification confirmation emails
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ── Admin ─────────────────────────────────────────────────────────────────────
ORQE_ADMIN_EMAIL=admin@filantus.com
